# ---------------------------------------------------------------------------
# Katalon – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach .env und passe alle Werte an.
# Die .env-Datei darf NIE in Git eingecheckt werden.
# ---------------------------------------------------------------------------

# --- Datenbank ---
POSTGRES_USER=katalon
POSTGRES_PASSWORD=BITTE_AENDERN
POSTGRES_DB=katalon
DATABASE_URL=postgresql+asyncpg://katalon:BITTE_AENDERN@db:5432/katalon

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX_NAME=katalon_records

# --- Cantaloupe (IIIF Image Server) ---
CANTALOUPE_URL=http://cantaloupe:8182
# Öffentliche Basis für IIIF-Manifeste (lokal über nginx: http://localhost; Produktion: z.B. https://iiif.example.org)
CANTALOUPE_PUBLIC_URL=http://localhost
# Größe des tmpfs-Derivative-Cache. Ohne Limit erlaubt Docker bis zu 50% des Host-RAM pro Mount —
# bei mehreren Instanzen auf einem Host bewusst so wählen, dass die Summe aller Instanzen den
# verfügbaren RAM nicht sprengt (Puffer für ES/Postgres einplanen).
CANTALOUPE_CACHE_TMPFS_SIZE=512m

# --- Sicherheit ---
# Mindestens 32 zufällige Zeichen: openssl rand -hex 32
SECRET_KEY=BITTE_AENDERN
KATALON_SECRETS_KEY=BITTE_AENDERN_MIN_32_ZEICHEN

# --- Deployment-URL ---
# Wird beim ersten Start verwendet, um den initialen Admin-Account abzuleiten.
# Beispiel: https://katalon.example.org
KATALON_BASE_URL=https://katalon.example.org

# --- E-Mail (optional; transaktionale Mails ueber externen SMTP-Relay) ---
# SMTP_PASSWORD ist ein Betreiber-Secret und darf nie eingecheckt werden.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Katalon <noreply@example.org>
# STARTTLS (Port 587) oder implizites TLS (meist Port 465), genau eines aktivieren.
SMTP_STARTTLS=true
SMTP_SSL_TLS=false
SMTP_TIMEOUT_SECONDS=10

# --- Admin-Account (nur beim ersten Start) ---
# Fallback-Werte für lokale Entwicklung ohne KATALON_BASE_URL
DEFAULT_ADMIN_EMAIL=admin@example.org
DEFAULT_ADMIN_PASSWORD=BITTE_AENDERN
FIRST_RUN_CREDENTIALS_PATH=/var/lib/katalon/first-run-credentials.txt

# --- OAI-PMH ---
OAI_ADMIN_EMAIL=admin@example.org

# --- Normdaten ---
# Wikidata verlangt einen identifizierbaren User-Agent mit URL und Kontakt.
# Leer lassen, um KATALON_BASE_URL + OAI_ADMIN_EMAIL zu verwenden.
WIKIDATA_USER_AGENT=

# GeoNames-Webservice-Benutzername; Konto nach E-Mail-Bestätigung im Webservice aktivieren.
GEONAMES_USERNAME=

# --- DNB URN ---
# Für Entwicklung mit Mock-Endpunkt (lokal): http://localhost:8000/v1/dnb-urn-mock
DNB_URN_ENABLED=false
DNB_URN_API_URL=https://api.nbn-resolving.org/v2/
DNB_URN_NAMESPACE=
DNB_URN_USERNAME=
DNB_URN_PASSWORD=
DNB_URN_RESOLVER_URL=https://nbn-resolving.org/

# --- ARK ---
# Erst nach NAAN-Vergabe durch die ARK Alliance aktivieren. N2T leitet jeden
# ARK anschliessend an diese Katalon-Instanz weiter; KATALON_BASE_URL muss
# deshalb die dauerhaft öffentliche URL sein.
ARK_ENABLED=false
ARK_NAAN=
ARK_RESOLVER_URL=https://n2t.net/
ARK_SUFFIX_LENGTH=10

# --- Medien ---
# Host-Pfad für Mediendateien (Bind Mount).
# Der Container mountet diesen Pfad unter /var/lib/katalon/media.
# Muss auf dem Host existieren und UID/GID 1000 (app-User in api/worker) gehören:
# install -d -o 1000 -g 1000 -m 755 /srv/katalon/media
# (nicht "mkdir -p" — das Verzeichnis gehört sonst root:root, Uploads schlagen
# dann mit Permission denied fehl, ohne Fehlermeldung im Container-Status)
# Empfohlen: /srv/katalon/media (Linux FHS) oder ein NFS-Mount.
MEDIA_ROOT=/srv/katalon/media
MAX_UPLOAD_SIZE_MB=200

# --- Importer ---
# Maximale Gesamtgröße für Uploads zum Importer (XML/CSV/Excel), in MB.
IMPORTER_MAX_UPLOAD_SIZE_MB=500
# Wie lange ein hochgeladenes Import-Paket im Redis zwischengespeichert wird
# (Upload -> Mapping -> Import), in Sekunden. Default = 4 Stunden.
IMPORTER_UPLOAD_TTL_SECONDS=14400

# --- Backups (backup-Service: pg_dump + Media-tar) ---
# Backups an/aus (false = Service läuft, macht aber nichts)
BACKUP_ENABLED=true
# Host-Pfad für die Backups. Muss existieren: mkdir -p /srv/katalon/backups
BACKUP_ROOT=/srv/katalon/backups
# Aufbewahrung in Tagen (ältere Dumps werden gelöscht)
BACKUP_RETENTION_DAYS=14
# Zeitplan: entweder feste Uhrzeit ODER Intervall.
# Feste Uhrzeit (HH:MM, Container-Zeitzone = UTC, sofern nicht per TZ gesetzt):
BACKUP_AT=03:00
# Intervall in Sekunden — nur wirksam, wenn BACKUP_AT leer ist (86400 = täglich):
BACKUP_INTERVAL_SECONDS=86400

# --- CORS (JSON-Array, kein trailing slash) ---
CORS_ORIGINS=["https://admin.example.org","https://example.org"]

# --- Elasticsearch ---
# Heap-Größe für Elasticsearch (Xms und Xmx werden gleich gesetzt)
# Für kleine Server (4 GB RAM): 512m
# Für normale Server (8+ GB RAM): 1g
ES_HEAP_SIZE=512m

# --- Frontend-Build (Produktion) ---
# Werden bei `docker compose -f docker-compose.yml -f docker-compose.prod.yml build`
# in die Admin/Portal-Images eingebaut. Leer = relative Pfade (Funktioniert mit
# der Subdomain-Konfiguration aus docs/04_produktion.md, weil nginx /v1/ proxyt).
ADMIN_VITE_API_URL=
PORTAL_VITE_API_URL=
PORTAL_URL=
VITE_ADMIN_FEEDBACK_ENABLED=
VITE_PORTAL_FEEDBACK_ENABLED=
DEBUG=false
