FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_PORTAL_FEEDBACK_ENABLED=
ENV VITE_PORTAL_FEEDBACK_ENABLED=$VITE_PORTAL_FEEDBACK_ENABLED
COPY frontend/portal/package*.json ./
RUN npm install
COPY frontend/portal /app
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.portal.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
