FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_ADMIN_FEEDBACK_ENABLED=
ARG VITE_API_URL=
ARG VITE_PORTAL_URL=
ENV VITE_ADMIN_FEEDBACK_ENABLED=$VITE_ADMIN_FEEDBACK_ENABLED
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PORTAL_URL=$VITE_PORTAL_URL
COPY frontend/admin/package*.json ./
RUN npm install
COPY frontend/admin /app
RUN VITE_BASE_PATH=/admin/ npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
