FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.4 /uv /uvx /bin/

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src/ src/
RUN --mount=type=cache,target=/root/.cache/uv uv pip install --system .

RUN groupadd -g 1000 app && useradd -u 1000 -g app -M -s /usr/sbin/nologin app \
    && mkdir -p /var/lib/katalon && chown -R app:app /app /var/lib/katalon
USER app

CMD ["celery", "-A", "katalon.workers.celery_app", "worker", "--pool=threads", "--loglevel=info"]
